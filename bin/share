#!/usr/bin/env bash
# share -- publish files to the private mb-shares worker (Cloudflare Workers KV).
# Publishing is instant (no builds; directory uploads PUT 8-way parallel).
# Viewers sign in with their @metabase.com Google account.
set -euo pipefail

CONF="${SHARE_CONF:-$HOME/.config/mb-shares/env}"
[ -f "$CONF" ] || { echo "missing $CONF (needs BASE_URL and UPLOAD_TOKEN)" >&2; exit 1; }
. "$CONF"

# every publish also lands in a local mirror (archive of everything shared);
# override with MIRROR_DIR in the env file. `share rm` leaves the mirror.
MIRROR_DIR="${MIRROR_DIR:-$HOME/.local/share/mb-shares}"

auth() { curl -sSf --retry 2 -H "Authorization: Bearer $UPLOAD_TOKEN" "$@"; }
enc() { python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))' "$1"; }
# accept a pasted share URL anywhere a slug is expected: strip scheme://host/ and trailing /
deslug() {
  local a="$1"
  case "$a" in *://*) a="${a#*://}"; a="${a#*/}" ;; esac
  printf '%s' "${a%/}"
}

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
usage: share <file-or-dir> [name]        publish (new slug w/ random suffix)
       share <files...>                  glob form: one share named for parent dir
       share -e <file-or-dir> <slug>     overwrite existing share (same URL)
       share -x <file-or-dir> <name>     exact slug, no random suffix (fails if taken)
       ... | share [-e] -f <name> [slug] publish stdin as file <name>
       share rm <url-or-slug>            delete a share (local mirror copy stays)
       share download <url-or-slug> [dest]  pull a share's files into dest/ (default: slug/)
       share cat <url-or-slug>[/file]    print share contents to stdout (URL ok as-is)
       share ls <url-or-slug>            list files in a share
       share --local <url-or-slug>[/file]  print the local path a share came from
       share views <url-or-slug>         who viewed a share (email, count, last)
       share                             list all shares

examples:
  share thing.md                   publish file -> prints URL instantly
  share ./some-dir                 publish whole directory
  share ./dir cool-name            custom name (still gets random suffix)
  share -x report.md standup       exact memorable URL: /standup/ (guessable!)
  pbpaste | share -f slides.html   stdin; .html/.md becomes the share's index
  share -e ./dir cool-name-a3f2b   overwrite existing share, same URL
  share                            list your share slugs
  share cat https://…/report-a3f2b/   read a pasted share URL (agent-friendly)
  share rm cool-name-a3f2b         delete

Viewers need a @metabase.com Google login; URLs are safe to paste anywhere.
A single .md/.html file publishes as the share's index (remote name
index.md/index.html) so the slug URL renders it directly. file:// URLs work
as publish paths (drag-and-drop / "Copy as URL").
Every publish also lands in ~/.local/share/mb-shares/<slug>/ (override with
MIRROR_DIR in the env file) -- a mirror of each share's current content
(-e replaces it; rm leaves it).
First-time setup: sign in at the share site and visit /_token for your
personal token, config snippet, and a copy of this script.
EOF
    exit 0 ;;
  --local|local)
    # url -> the local path it was published from. Publishes record
    # slug<TAB>source in $MIRROR_DIR/.sources; last entry wins (-e edits).
    # Source gone (stdin share, moved dir, other machine) -> mirror copy.
    arg="$(deslug "${2:?usage: share --local <url-or-slug>[/file]}")"
    top="${arg%%/*}"; rest="${arg#"$top"}"
    src="$(awk -F'\t' -v s="$top" '$1==s{p=$2} END{if(p)print p}' "$MIRROR_DIR/.sources" 2>/dev/null || true)"
    if [ -n "$src" ] && [ -e "$src" ]; then
      if [ -d "$src" ]; then printf '%s%s\n' "$src" "$rest"; else printf '%s\n' "$src"; fi
      exit 0
    fi
    [ -e "$MIRROR_DIR/$arg" ] && { printf '%s\n' "$MIRROR_DIR/$arg"; exit 0; }
    echo "no local copy of '$top' (published from another machine?)" >&2; exit 1 ;;
  views)
    slug="$(deslug "${2:?usage: share views <url-or-slug>}")"
    out="$(auth "$BASE_URL/$(enc "$slug")/_views")"
    [ -n "$out" ] || { echo "no views yet" >&2; exit 0; }
    printf '%s\n' "$out" | column -t -s $'\t'
    exit 0 ;;
  rm)
    slug="$(deslug "${2:?usage: share rm <slug>}")"
    auth -X DELETE "$BASE_URL/$(enc "$slug")/"
    exit 0 ;;
  ls)
    slug="$(deslug "${2:?usage: share ls <url-or-slug>}")"
    out="$(auth "$BASE_URL/_list?prefix=$(enc "$slug/")" || true)"
    [ -n "$out" ] || { echo "no share '$slug' (run \`share\` to list)" >&2; exit 1; }
    while IFS= read -r k; do printf '%s\n' "${k#"$slug"/}"; done <<< "$out"
    exit 0 ;;
  cat)
    arg="$(deslug "${2:?usage: share cat <url-or-slug>[/file]}")"
    if [ "${arg#*/}" != "$arg" ]; then
      # slug/path form -> one file, raw
      auth "$BASE_URL/$(enc "$arg")"
      exit 0
    fi
    files=()
    while IFS= read -r k; do files+=("$k"); done < <(auth "$BASE_URL/_list?prefix=$(enc "$arg/")")
    [ "${#files[@]}" -gt 0 ] || { echo "no share '$arg' (run \`share\` to list)" >&2; exit 1; }
    for k in ${files[@]+"${files[@]}"}; do
      if [ "${#files[@]}" -gt 1 ]; then printf '==> %s <==\n' "${k#"$arg"/}"; fi
      auth "$BASE_URL/$(enc "$k")"
      if [ "${#files[@]}" -gt 1 ]; then printf '\n'; fi
    done
    exit 0 ;;
  download)
    slug="$(deslug "${2:?usage: share download <slug> [dest]}")"
    dest="${3:-$slug}"
    n=0
    while IFS= read -r k; do
      rel="${k#"$slug"/}"
      mkdir -p "$dest/$(dirname "$rel")"
      auth -o "$dest/$rel" "$BASE_URL/$(enc "$k")"
      n=$((n + 1))
    done < <(auth "$BASE_URL/_list?prefix=$(enc "$slug/")")
    [ "$n" -gt 0 ] || { echo "no share '$slug' (run \`share\` to list)" >&2; exit 1; }
    echo "downloaded $n file(s) to $dest/" >&2
    exit 0 ;;
esac

if [ $# -eq 0 ]; then
  auth "$BASE_URL/_list"
  exit 0
fi

EDIT=0 EXACT=0
while :; do
  case "${1:-}" in
    -e|--edit)  EDIT=1; shift ;;
    -x|--exact) EXACT=1; shift ;;
    *) break ;;
  esac
done

# stdin mode (gh-gist muscle memory): `pbpaste | share -f slides.html [name]`
if [ "${1:-}" = "-f" ] || [ "${1:-}" = "--filename" ]; then
  FNAME="${2:?usage: ... | share [-e] -f <filename> [name]}"
  TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
  cat > "$TMP/$FNAME"
  shift 2; set -- "$TMP/$FNAME" "$@"
fi

SRC="${1:?usage: share [-e] <file-or-dir> [name]}"
# accept file:// URLs (drag-and-drop, "Copy as URL"): strip scheme, %-decode
case "$SRC" in file://*)
  SRC="$(python3 -c 'import urllib.parse,sys; print(urllib.parse.unquote(sys.argv[1][7:]))' "$SRC")" ;;
esac
SRC="$(cd "$(dirname "$SRC")" && pwd)/$(basename "$SRC")"
[ -e "$SRC" ] || { echo "no such path: $SRC" >&2; exit 1; }

MULTI=()
if [ -n "${2:-}" ] && [ -e "$2" ]; then
  # glob form (`share dir/*`): every extra arg is an existing path -> one
  # share named for the first arg's parent dir; file args land at top
  # level, dir args nest under basename(dir)/
  MULTI=("$@")
  NAME="$(basename "$(dirname "$SRC")")"
elif [ -n "${2:-}" ]; then
  NAME="$2"
elif [ -f "$SRC" ]; then
  base="$(basename "$SRC")"; NAME="${base%.*}"
else
  NAME="$(basename "$SRC")"
fi
NAME="$(echo "$NAME" | tr ' ' '-')"

if [ "$EDIT" = 1 ]; then
  # per-slug manifest lookup, not the bare _list: that one is cached ~60s,
  # so a share published moments ago would read as missing
  [ -n "$(auth "$BASE_URL/_list?prefix=$(enc "$NAME/")" || true)" ] \
    || { echo "no existing share '$NAME' (run \`share\` to list); omit -e to create new" >&2; exit 1; }
  # no DELETE: the uploads fill a new version and finalize makes it live,
  # so the old version stays up until then
  rm -rf "${MIRROR_DIR:?}/$NAME"   # mirror tracks the share's current content
elif [ "$EXACT" = 1 ]; then
  # exact slug: no suffix, so check it's free first -- anyone's share, not
  # just ours (a later PUT into someone else's slug would 403 mid-upload)
  if [ -n "$(auth "$BASE_URL/_list?prefix=$(enc "$NAME/")" || true)" ]; then
    echo "share '$NAME' already exists (yours? overwrite with -e)" >&2; exit 1
  fi
else
  NAME="$NAME-$(openssl rand -hex 3)"
fi

# share links point to the content host; BASE_URL is the API
URL="${CONTENT_URL:-$BASE_URL}/$(enc "$NAME")/"
echo "$URL"

# remember where this share came from, for `share --local <url>`
SRC_REC="$SRC"
[ "${#MULTI[@]}" -gt 0 ] && SRC_REC="$(dirname "$SRC")"
mkdir -p "$MIRROR_DIR"
printf '%s\t%s\n' "$NAME" "$SRC_REC" >> "$MIRROR_DIR/.sources"

# every put records the remote name (finalize POSTs the list so the worker
# can maintain the share's manifest without KV list() calls) and copies the
# file into the local mirror under the share's exact remote layout
MAN=()
mirror() { mkdir -p "$(dirname "$MIRROR_DIR/$NAME/$2")"; cp "$1" "$MIRROR_DIR/$NAME/$2"; }
put() { MAN+=("$2"); mirror "$1" "$2"; auth -T "$1" "$BASE_URL/$(enc "$NAME")/$(enc "$2")" > /dev/null; }

if [ "${#MULTI[@]}" -gt 0 ]; then
  for s in ${MULTI[@]+"${MULTI[@]}"}; do
    [ -e "$s" ] || { echo "no such path: $s" >&2; exit 1; }
    if [ -f "$s" ]; then
      put "$s" "$(basename "$s")"
    else
      while IFS= read -r f; do
        put "$f" "$(basename "$s")/${f#"${s%/}"/}"
      done < <(find -L "$s" -type f ! -path '*/.git/*')
    fi
  done
elif [ -f "$SRC" ]; then
  # single md/html becomes the share's index so the slug URL renders it directly
  case "$SRC" in
    *.md)   put "$SRC" index.md ;;
    *.html) put "$SRC" index.html ;;
    *)      put "$SRC" "$(basename "$SRC")" ;;
  esac
else
  pids=()
  while IFS= read -r f; do
    rel="${f#"$SRC"/}"
    MAN+=("$rel")
    mirror "$f" "$rel"
    auth -T "$f" "$BASE_URL/$(enc "$NAME")/$(enc "$rel")" > /dev/null &
    pids+=($!)
    [ "${#pids[@]}" -ge 8 ] && { wait "${pids[0]}"; pids=("${pids[@]:1}"); }
  done < <(find -L "$SRC" -type f ! -path '*/.git/*')
  for p in ${pids[@]+"${pids[@]}"}; do wait "$p"; done
fi

# an empty MAN means we uploaded nothing (unreadable or empty source): the
# slug would finalize to a manifest of zero files and 404 on view
[ "${#MAN[@]}" -eq 0 ] && { echo "no files found under $SRC -- nothing uploaded" >&2; exit 1; }

printf '%s\n' ${MAN[@]+"${MAN[@]}"} | auth -X POST --data-binary @- "$BASE_URL/_finalize/$(enc "$NAME")" > /dev/null

echo "uploaded" >&2
